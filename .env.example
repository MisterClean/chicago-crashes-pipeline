# Copy values into your local environment manager or Railway service variables.
# The Rust executable does not implicitly load .env files.
APP_ENV=development
BIND_ADDRESS=127.0.0.1
PORT=8003
DATA_DIR=.local/data
DUCKDB_MEMORY_LIMIT=192MB
DUCKDB_THREADS=2
DUCKDB_QUERY_TIMEOUT_SECONDS=120
PUBLIC_CACHE_BYTES=16777216
DAILY_SYNC=false
INGESTION_MAX_CHANGED_ROWS=25000
CRASHES_INGESTION_MAX_BYTES=8589934592

# Production requires a strong API_KEY of at least 32 bytes and all EXPORT_* values.
API_KEY=
EXPORT_ENDPOINT=
EXPORT_BUCKET=
EXPORT_ACCESS_KEY_ID=
EXPORT_SECRET_ACCESS_KEY=
EXPORT_REGION=auto

# Frontend service (Node 22):
BACKEND_URL=http://127.0.0.1:8003
NEXT_PUBLIC_API_URL=/api
# Optional explicit style URL takes precedence over the public Protomaps key.
# With both empty, the browser uses CARTO Positron.
NEXT_PUBLIC_BASEMAP_URL=
NEXT_PUBLIC_PROTOMAPS_KEY=
